<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">#2D6EF5</item>
        <item name="colorAccent">#2D6EF5</item>
    </style>

    <style name="Theme.Player.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#5B8DFF</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#E5E7EB</item>
    </style>
</resources>
